@model MeterReadingIndexViewModel
@{ ViewData["Title"] = "Meter Readings"; }

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h2 class="fw-bold mb-0">📊 Meter Readings</h2>
        <div class="d-flex gap-2">
            <a asp-controller="Report" asp-action="Index" class="btn btn-outline-info btn-sm">📄 Export PDF</a>
            <a asp-action="Create" class="btn ww-btn-primary">+ Add Reading</a>
        </div>
    </div>

    <!-- Filter -->
    <form method="get" class="d-flex gap-2 mb-4 flex-wrap">
        <select name="connectionId" class="form-select ww-input" style="max-width:320px">
            <option value="">— All Connections —</option>
            @foreach (var conn in Model.Connections)
            {
                if (Model.FilterConnectionId == conn.Id)
                {
                    <option value="@conn.Id" selected>@conn.Label</option>
                }
                else
                {
                    <option value="@conn.Id">@conn.Label</option>
                }
            }
        </select>
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
        @if (Model.FilterConnectionId.HasValue)
        {
            <a asp-action="Index" class="btn btn-outline-danger btn-sm align-self-center">✕ Clear</a>
        }
    </form>

    @if (!Model.Readings.Any())
    {
        <div class="ww-card p-5 text-center text-muted">
            <div style="font-size:3rem">📊</div>
            <h4 class="mt-3">No readings found</h4>
            <p>Add your first meter reading to start tracking consumption.</p>
            <a asp-action="Create" class="btn ww-btn-primary mt-2">Add Reading</a>
        </div>
    }
    else
    {
        <div class="ww-card p-3">
            <div class="table-responsive">
                <table class="table table-dark table-hover table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Consumer No.</th>
                            <th>Date</th>
                            <th>Previous</th>
                            <th>Current</th>
                            <th>Grid Units</th>
                            <th>Solar Gen.</th>
                            <th>Bill (₹)</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Readings)
                        {
                            <tr>
                                <td class="fw-semibold" style="color:#2563EB;">
                                    @r.ConsumerNumber
                                    @if (r.ConnectionHasSolar)
                                    {
                                        <span class="ms-1" title="Solar connection" style="color:#16A34A;font-size:.8rem">☀️</span>
                                    }
                                </td>
                                <td class="text-muted small">@r.ReadingDate.ToString("dd MMM yyyy")</td>
                                <td>@r.PreviousReading.ToString("F2")</td>
                                <td>@r.CurrentReading.ToString("F2")</td>
                                <td class="fw-semibold">@r.UnitsConsumed.ToString("F2") kWh</td>
                                <td class="small @(!r.SolarGenerationKwh.HasValue ? "text-muted fst-italic" : "")">
                                    @(r.ConnectionHasSolar
                                        ? (r.SolarGenerationKwh.HasValue ? r.SolarGenerationKwh.Value.ToString("F2") + " kWh" : "—")
                                        : "N/A")
                                </td>
                                <td class="fw-semibold" style="color:#2563EB;">₹@r.BillAmount.ToString("F2")</td>
                                <td>
                                    <span class="badge @(r.IsPaid ? "bg-success" : "bg-warning text-dark")">
                                        @(r.IsPaid ? "Paid" : "Due")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@r.ReadingId" class="btn btn-sm btn-outline-info">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-center mt-3">
                    <nav>
                        <ul class="pagination pagination-sm">
                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.Page ? "active" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-connectionId="@Model.FilterConnectionId"
                                       asp-route-page="@p">@p</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        </div>
    }
</div>



