@model IEnumerable<WattWise.Models.Connection>
@{ ViewData["Title"] = "My Connections"; }

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h2 class="fw-bold mb-0">🔌 Electricity Connections</h2>
        <a asp-action="Create" class="btn ww-btn-primary">+ Add Connection</a>
    </div>

    @if (!Model.Any())
    {
        <div class="ww-card p-5 text-center text-muted">
            <div style="font-size:3rem">🔌</div>
            <h4 class="mt-3">No connections yet</h4>
            <p>Add your first electricity connection to start tracking usage and bills.</p>
            <a asp-action="Create" class="btn ww-btn-primary mt-2">Add Connection</a>
        </div>
    }
    else
    {
        <div class="ww-card p-3">
            <div class="table-responsive">
                <table class="table table-dark table-hover table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Consumer No.</th>
                            <th>Type</th>
                            <th>Address</th>
                            <th>Load (kW)</th>
                            <th>Connected On</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td class="fw-semibold" style="color:#2563EB;">@c.ConsumerNumber</td>
                                <td>@c.ConnectionType</td>
                                <td class="text-muted">@c.Address</td>
                                <td>@c.SanctionedLoad kW</td>
                                <td class="text-muted small">@c.ConnectedOn.ToLocalTime().ToString("dd MMM yyyy")</td>
                                <td>
                                    <span class="badge @(c.IsActive ? "bg-success" : "bg-secondary")">
                                        @(c.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@c.ConnectionId" class="btn btn-sm btn-outline-info me-1">Details</a>
                                    <a asp-action="Edit" asp-route-id="@c.ConnectionId" class="btn btn-sm btn-outline-secondary me-1">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@c.ConnectionId" class="btn btn-sm btn-outline-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>



